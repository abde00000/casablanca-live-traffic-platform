# Copy to .env and edit locally. Never commit .env or paste the API key into chat.
TOMTOM_API_KEY=replace_with_your_private_key

# Local development only; use a strong password even for a laptop demo.
POSTGRES_DB=hive_metastore
POSTGRES_USER=hive
POSTGRES_PASSWORD=change_this_local_password

# API collection settings (the default samples 16 locations once per hour)
TOMTOM_FLOW_API_URL=https://api.tomtom.com/traffic/services/4/flowSegmentData/absolute/10/json
POLL_INTERVAL_SECONDS=3600
MAX_REQUESTS_PER_MONTH=18000
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=3
STORE_RAW_PROVIDER_RESPONSE=false

# Spark/storage settings
SPARK_MASTER_URL=spark://spark-master:7077
TRAFFIC_DATA_ROOT=/opt/traffic-data
